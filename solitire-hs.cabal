cabal-version:      3.0
name:               solitire-hs
version:            0.1.0.0
synopsis:           Solitaire engine, terminal games, and solver
description:
    A pure, rule-driven solitaire engine with Klondike, Spider, FreeCell,
    Yukon, Golf, and Grandfather's Clock, plus a terminal interface and
    a bounded solver.
license:            BSD-3-Clause
license-file:       LICENSE
author:             k-kozika
maintainer:         127573443+k-kozika@users.noreply.github.com
category:           Game
build-type:         Simple
tested-with:        GHC ==9.10.3
extra-doc-files:
    README.md
    CHANGELOG.md

common shared
    default-language: Haskell2010
    ghc-options:      -Wall
    build-depends:    base >=4.18 && <4.23

library
    import:           shared
    hs-source-dirs:   src
    exposed-modules:
        Solitaire.Engine
        Solitaire.Games
        Solitaire.Games.FreeCell
        Solitaire.Games.Golf
        Solitaire.Games.GrandfathersClock
        Solitaire.Games.Klondike
        Solitaire.Games.Spider
        Solitaire.Games.Yukon
        Solitaire.Solver
    build-depends:    containers >=0.6 && <0.9

executable solitaire
    import:           shared
    hs-source-dirs:   app
    main-is:          Main.hs
    build-depends:    solitire-hs

executable solitaire-solve
    import:           shared
    hs-source-dirs:   app
    main-is:          Solve.hs
    build-depends:    solitire-hs

test-suite solitire-hs-test
    import:           shared
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Spec.hs
    build-depends:
        containers >=0.6 && <0.9,
        solitire-hs
